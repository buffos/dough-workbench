---
const basePath = import.meta.env.BASE_URL;
const englishWorkspace = `${basePath}en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${englishWorkspace}`} />
    <link rel="canonical" href={englishWorkspace} />
    <title>Dough Formula Intelligence</title>
  </head>
  <body>
    <p>
      Continue to the <a href={englishWorkspace}>English formula workspace</a>.
    </p>
  </body>
</html>
