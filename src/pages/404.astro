---
import LocaleLayout from '../layouts/LocaleLayout.astro';

const basePath = import.meta.env.BASE_URL;
---

<LocaleLayout locale="en" basePath={basePath}>
  <main style="min-height: 70vh; display:grid; place-items:center; padding: 2rem; text-align:center;">
    <div>
      <p style="letter-spacing:.14em; text-transform:uppercase; color:#a4624c; font-size:.7rem;">DFI / 404</p>
      <h1 style="font-family:Georgia,serif; font-weight:400; color:#2f5144;">This route is not part of the formula.</h1>
      <a href={`${basePath}en/`} style="color:#a15c44;">Return to the workspace →</a>
    </div>
  </main>
</LocaleLayout>
