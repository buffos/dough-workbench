---
import LocaleLayout from '../../layouts/LocaleLayout.astro';
import PrototypeCatalogPanel from '../../components/PrototypeCatalogPanel.svelte';

const locale = 'en';
const basePath = import.meta.env.BASE_URL;
---

<LocaleLayout locale={locale} basePath={basePath}>
  <PrototypeCatalogPanel locale={locale} basePath={basePath} client:load />
</LocaleLayout>
